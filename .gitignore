.secrets.env

# Generated from .secrets.env by scripts/gen-secrets-go.sh, the first step
# of wasm_compile -- real credentials, never committed.
guest/secrets_generated.go

# natyv prepare's own regenerated output -- reproducible from app.go.ntx,
# never hand-edited (carries a "DO NOT EDIT" header).
guest/*.natyv.go
guest/styletokens_generated.go
guest/.natyv-build-cache

# natyv build's own compiled/bundled output.
guest/*.wasm
dist/

// Real, hardcoded natyv-core limitation (2026-09-02, confirmed by reading
// Label.zig): text always renders at rgb(220,220,220) -- no NTSS override
// exists. Every color below stays dark enough for that fixed light-gray
// text to stay legible; a light theme genuinely isn't reachable today
// without a real host-side text-color feature.

root {
  direction: topToBottom
  width: grow
  height: grow
  backgroundColor: "#14161AFF"
}

toolbar {
  direction: leftToRight
  childGap: 8
  width: grow
  height: 48
  alignY: center
}

toolbarBtn {
  width: grow
  backgroundColor: "#20242CFF"
  cornerRadius: {8, 8, 8, 8}
}

// padding/childGap trimmed down from 8 (2026-09-02) -- at the default page
// size of 5, the old spacing pushed the "< N >" pager below the window's
// visible area. Every child here (folder label, btnRow, each message row,
// pagerRow) paid the childGap cost, so this is the single biggest lever for
// fitting a full page on screen.
content {
  direction: topToBottom
  width: grow
  height: grow
  childGap: 4
  padding: 4
}

// FolderView's own persisted rows-only parent (2026-09-02) -- lets
// navigatePage destroy and rebuild just the message rows on Older/Newer/
// Refresh, leaving the folder label/toolbar/pager alive. childGap matches
// content's own, since rows used to be content's direct children sharing
// its childGap -- moving them one level in here keeps the same visual
// spacing between rows as before. height: grow (not fit) so this
// container always claims every bit of vertical space content isn't
// using for the label/toolbar/pager, regardless of how many real rows
// are inside it -- otherwise, with few rows, the pager would sit right
// below them instead of pinned to the window's own bottom edge.
rowsList {
  direction: topToBottom
  width: grow
  height: grow
  childGap: 4
}

// padding trimmed from 10 -> 5 (2026-09-02), same "fit a full page on
// screen" reason as content's own trim above.
row {
  direction: topToBottom
  width: grow
  height: fit
  childGap: 2
  padding: 5
  backgroundColor: "#1E212AFF"
  cornerRadius: {10, 10, 10, 10}
}

// The checkbox+text-stack row inside a card -- leftToRight so the
// checkbox sits to the left of the from/subject text, not stacked above
// it the way row's own direction (used when row had no checkbox) is.
rowContent {
  direction: leftToRight
  width: grow
  childGap: 8
  alignY: center
}

// from/subject stacked vertically, to the right of the checkbox.
rowText {
  direction: topToBottom
  width: grow
  childGap: 2
}

rowCheckbox {
  width: 24
  height: 24
}

field {
  width: grow
}

btnRow {
  direction: leftToRight
  width: grow
  height: fit
  childGap: 4
}

// The bottom "< N >" pager row -- centered, unlike btnRow's own
// left-aligned toolbar rows.
pagerRow {
  direction: leftToRight
  width: grow
  height: fit
  childGap: 8
  alignX: center
  alignY: center
}

// Fixed, not fit -- Button auto-width (2026-09-02) is Button-only today,
// not yet extended to Label.
pagerLabel {
  width: 90
}

// Combined with secondaryBtn (styles={secondaryBtn, pagerBtn}) on the "<"/
// ">" pager buttons -- real width: fit sizes each tightly around its own
// single glyph instead of Button's own much wider 120px default.
pagerBtn {
  width: fit
}

bodyArea {
  width: grow
  height: grow
}

// Button color roles, applied on top of each <Button>'s own default fixed
// size -- shared across the toolbar's own children (via toolbarBtn above)
// and every dynamic view.
primaryBtn {
  backgroundColor: "#3B6BF5FF"
  cornerRadius: {6, 6, 6, 6}
}

secondaryBtn {
  backgroundColor: "#2A2E37FF"
  cornerRadius: {6, 6, 6, 6}
}

// Only ever used for "Delete Selected" -- width: fit sizes it to its own
// real label text (a live count, "Delete Selected (N)") via natyv-core's
// new real font-driven Button auto-width (2026-09-02), rather than a
// manually-tuned fixed width that would either overflow or waste space
// as N's digit count changes.
dangerBtn {
  backgroundColor: "#C1443FFF"
  cornerRadius: {6, 6, 6, 6}
  width: fit
}

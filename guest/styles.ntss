// Real, hardcoded natyv-core limitation (2026-09-02, confirmed by reading
// Label.zig): text always renders at rgb(220,220,220) -- no NTSS override
// exists. Every color below stays dark enough for that fixed light-gray
// text to stay legible; a light theme genuinely isn't reachable today
// without a real host-side text-color feature.

root {
  direction: topToBottom
  width: grow
  height: grow
  backgroundColor: "#14161AFF"
}

toolbar {
  direction: leftToRight
  childGap: 8
  width: grow
  height: 48
  alignY: center
}

toolbarBtn {
  width: grow
  backgroundColor: "#20242CFF"
  cornerRadius: {8, 8, 8, 8}
}

content {
  direction: topToBottom
  width: grow
  height: grow
  childGap: 8
}

// The purely-structural per-row wrapper MessageRow needs for its own
// ref-scoping trick (see views.go.ntx's own doc comment on it) -- a bare
// <Container> otherwise carries an unremovable 8px default padding on
// every side, which was stacking with `row`'s own padding below to
// visibly space rows much further apart than intended. Zeroing it out
// here (real NTSS padding override, 2026-09-02) removes that with no
// visual role of its own to lose.
rowWrap {
  padding: 0
}

row {
  direction: topToBottom
  width: grow
  height: fit
  childGap: 2
  padding: 10
  backgroundColor: "#1E212AFF"
  cornerRadius: {10, 10, 10, 10}
}

// The checkbox+text-stack row inside a card -- leftToRight so the
// checkbox sits to the left of the from/subject text, not stacked above
// it the way row's own direction (used when row had no checkbox) is.
rowContent {
  direction: leftToRight
  width: grow
  childGap: 8
  alignY: center
}

// from/subject stacked vertically, to the right of the checkbox.
rowText {
  direction: topToBottom
  width: grow
  childGap: 2
}

rowCheckbox {
  width: 24
  height: 24
}

field {
  width: grow
}

btnRow {
  direction: leftToRight
  width: grow
  height: fit
  childGap: 4
}

bodyArea {
  width: grow
  height: grow
}

// Button color roles, applied on top of each <Button>'s own default fixed
// size -- shared across the toolbar's own children (via toolbarBtn above)
// and every dynamic view.
primaryBtn {
  backgroundColor: "#3B6BF5FF"
  cornerRadius: {6, 6, 6, 6}
}

secondaryBtn {
  backgroundColor: "#2A2E37FF"
  cornerRadius: {6, 6, 6, 6}
}

// Only ever used for "Delete Selected" -- wider than a Button's own
// hardcoded 120px default since that label is longer than any other
// button's in this app. Real, disclosed natyv limitation: Button has no
// font-driven text measurement at all, so a longer label needs its own
// explicit width -- there's no "just let it grow to fit the text" option
// today the way there is for a Container (see fitSizing's own doc
// comment in shared's Codegen.zig).
dangerBtn {
  backgroundColor: "#C1443FFF"
  cornerRadius: {6, 6, 6, 6}
  width: 190
}

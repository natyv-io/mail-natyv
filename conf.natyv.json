{
  "name": "mail-natyv",
  "wasm_compile": "../scripts/gen-secrets-go.sh && tinygo build -target wasip1 -buildmode=c-shared -o mail-natyv.wasm .",
  "sqlite": {
    "enabled": false
  },
  "network": {
    "enabled": true,
    "tcp": {
      "allowed_sockets": [
        { "host": "imap.gmail.com", "port": 993, "tls": "implicit" },
        { "host": "smtp.gmail.com", "port": 465, "tls": "implicit" }
      ]
    }
  },
  "ui": {
    "backend": "clay"
  },
  "memory": {
    "recycle_threshold_mb": 105
  },
  "build_mode": "release_small"
}
